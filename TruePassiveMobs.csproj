<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="Environment.props" Condition="Exists('Environment.props')" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>TruePassiveMobs</AssemblyName>
    <RootNamespace>TruePassiveMobs</RootNamespace>
    <Version>1.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GamePath)' == '' And '$(OS)' == 'Windows_NT'">
    <GamePath>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 892970', 'InstallLocation', null, RegistryView.Registry64, RegistryView.Registry32))</GamePath>
  </PropertyGroup>
  <PropertyGroup Condition="!Exists('$(GamePath)') And '$(OS)' == 'Windows_NT'">
    <_SteamPath>$([MSBuild]::GetRegistryValueFromView('HKEY_CURRENT_USER\SOFTWARE\Valve\Steam', 'SteamPath', null, RegistryView.Registry32))</_SteamPath>
    <GamePath Condition="'$(_SteamPath)' != ''">$(_SteamPath)\steamapps\common\Valheim</GamePath>
  </PropertyGroup>
  <PropertyGroup Condition="!Exists('$(GamePath)')">
    <GamePath Condition="!Exists('$(GamePath)')">C:\Program Files (x86)\Steam\steamapps\common\Valheim</GamePath>
    <GamePath Condition="!Exists('$(GamePath)')">$(HOME)/.steam/steam/steamapps/common/Valheim</GamePath>
  </PropertyGroup>
  <PropertyGroup>
    <ManagedPath>$(GamePath)\valheim_Data\Managed</ManagedPath>
    <BepInExPath>$(GamePath)\BepInEx</BepInExPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <!-- Compile against Jotunn only; players install it separately (Thunderstore: ValheimModding-Jotunn).
         IncludeAssets="compile" also skips JotunnLib's own build targets. -->
    <PackageReference Include="JotunnLib" Version="2.29.0" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim" Publicize="true">
      <HintPath>$(ManagedPath)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedPath)\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExPath)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckGamePath" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedPath)\assembly_valheim.dll')" Text="Valheim not found at '$(GamePath)'. Pass -p:GamePath=... or create Environment.props (see top of TruePassiveMobs.csproj)." />
    <Error Condition="!Exists('$(BepInExPath)\core\BepInEx.dll')" Text="BepInEx not found in '$(BepInExPath)'. Install BepInExPack_Valheim first." />
  </Target>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true' And Exists('$(BepInExPath)\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExPath)\plugins\TruePassiveMobs" />
    <Message Importance="high" Text="TruePassiveMobs -> $(BepInExPath)\plugins\TruePassiveMobs" />
  </Target>

</Project>
